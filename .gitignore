# ==============================================================================
# CyberPulse NIDS/IPS — Git Ignore Configuration
# ==============================================================================

# Node & Frontend Dependencies and Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
.vite/
frontend/.vite/

# Node Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Virtual Environments
__pycache__/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
frontend/.env.local
*.env.local

# Explicitly retain environment template files
!*.env.example
!backend/.env.example
!frontend/.env.example

# Local SQLite, Database & Network Packet Captures
*.sqlite
*.sqlite3
*.db
*.pcap
*.pcapng
*.cap

# ML Training Datasets & Raw Benchmarks (e.g. CIC-IDS2017 raw CSVs/PCAPs)
backend/ml/data/
backend/ml/raw/
*.csv

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
backend/ml/.ipynb_checkpoints/

# Committed Production Machine Learning Artifacts (Ensure these are tracked)
!backend/ml/nids_model.onnx
!backend/ml/scaler.pkl
!backend/ml/nids_training.ipynb

# IDE, OS & System Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.log
.idea/

# VS Code (preserve shared settings/extensions, ignore local state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
