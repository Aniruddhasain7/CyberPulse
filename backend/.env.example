# ==============================================================================
# CyberPulse NIDS/IPS — Backend Environment Configuration Template
# ==============================================================================

# PostgreSQL Connection String (e.g. Neon Serverless or Local PostgreSQL)
# Example: postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/cyberpulse"

# Python Optimization (disable writing .pyc files)
PYTHONDONTWRITEBYTECODE=1

# Optional Machine Learning Artifact Paths (defaults to backend/ml/)
# MODEL_PATH="ml/nids_model.onnx"
# SCALER_PATH="ml/scaler.pkl"

# Flow Assembly Idle Timeout (seconds before idle network flow is finalized and classified)
CAPTURE_IDLE_TIMEOUT=5

# Allowed CORS Origin for Frontend
CORS_ORIGINS="http://localhost:5173"
